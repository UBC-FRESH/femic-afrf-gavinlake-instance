double default_improvement = 0.05;

void run_scenario_01(double improvement) { 
	/*
	 * Run the first scenario: maximize timber harvest
	 */ 
	 
	clearTargets();
	control.cancelTreatments(); 
	 
	// set maximize harvest volume target
	setActive("product.yield.managed.total", true, true, false); 
	setMinimumPeriodic("product.yield.managed.total", 500000, 1, 30); 
	setMinWeight("product.yield.managed.total", 1, 1, 30); 
	control.getTarget("product.yield.managed.total").setLinear(true);

	// set growing stock constraints- AFRF (90 percent of initial GS)
	setActive("feature.yield.managed.total", true, true, false); 
	setMinimumPeriodic("feature.yield.managed.total", 1277067, 30, 30);
	setMinWeight ("feature.yield.managed.total", 1, 30, 30); 

	// run the scheduler for a while before activating the even flow constraints
	gui.click("start");
	control.waitForIterations(50000);
	gui.clickAndWait("pause");

	//set even flow constraints
	setActive ("product.flow.yield.even", true, true, true); 
	setMinimumPeriodic("product.flow.yield.even", -1, 1, 30); 
	setMinWeight ("product.flow.yield.even", 1000, 1, 30); 
	setMaximumPeriodic("product.flow.yield.even", 1, 1, 30); 
	setMaxWeight ("product.flow.yield.even", 1000, 1, 30); 

	analyze("scenarios_AFRF_H/maximize timber harvest", 50000, improvement);
}

void run_scenario_01() {
	run_scenario_01(default_improvement);
}



void run_scenario_02(double improvement) { 
	/*
	 * Run the second scenario: maximize carbon stocks, hwp emission rate is 0
	 */ 
	 
	clearTargets();
	control.cancelTreatments(); 
	
	// set maximize carbon stock target
	setActive ("feature.carbon.managed.total.stock.0",true, true, false); 
	setMinimumPeriodic ("feature.carbon.managed.total.stock.0", 15000000, 1, 30); 
	setMinWeight ("feature.carbon.managed.total.stock.0", 1, 1, 30); 
	control.getTarget("feature.carbon.managed.total.stock.0").setLinear(true);

	// set growing stock constraints- AFRF (90 percent of initial GS)
